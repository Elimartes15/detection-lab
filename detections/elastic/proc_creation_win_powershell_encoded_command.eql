any where ((process.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll"))) and (process.command_line like~ ("* -e *", "* /e *", "* –e *", "* —e *", "* ―e *") or process.command_line like~ ("* -en *", "* /en *", "* –en *", "* —en *", "* ―en *") or process.command_line like~ ("* -enc *", "* /enc *", "* –enc *", "* —enc *", "* ―enc *") or process.command_line like~ ("* -enco *", "* /enco *", "* –enco *", "* —enco *", "* ―enco *") or process.command_line like~ ("* -encod *", "* /encod *", "* –encod *", "* —encod *", "* ―encod *") or process.command_line like~ ("* -encode*", "* /encode*", "* –encode*", "* —encode*", "* ―encode*") or process.command_line like~ ("* -ec *", "* /ec *", "* –ec *", "* —ec *", "* ―ec *"))
